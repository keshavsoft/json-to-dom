{
  "tagName": "div",
  "props": {
    "className": "max-w-2xl mx-auto p-6 space-y-6 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800"
  },
  "children": [
    {
      "tagName": "div",
      "props": {
        "className": "border-b border-slate-200 dark:border-slate-800 pb-4"
      },
      "children": [
        {
          "tagName": "h1",
          "props": {
            "className": "text-2xl font-bold text-slate-900 dark:text-white tracking-tight",
            "textContent": "${title}"
          }
        },
        {
          "tagName": "p",
          "props": {
            "className": "text-sm text-slate-500 dark:text-slate-400 mt-1",
            "textContent": "Showing ${totalCount} team members (Updated ${lastUpdated})"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "props": {
        "className": "space-y-3"
      },
      "$for": "members",
      "item": {
        "tagName": "div",
        "props": {
          "className": "flex items-center justify-between p-4 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md transition-shadow"
        },
        "children": [
          {
            "tagName": "div",
            "props": {
              "className": "flex items-center gap-3"
            },
            "children": [
              {
                "tagName": "img",
                "props": {
                  "className": "w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700",
                  "src": "${avatar}",
                  "alt": "${name}"
                }
              },
              {
                "tagName": "div",
                "props": {
                  "className": "flex flex-col"
                },
                "children": [
                  {
                    "tagName": "span",
                    "props": {
                      "className": "font-semibold text-slate-800 dark:text-slate-100 text-sm",
                      "textContent": "${name}"
                    }
                  },
                  {
                    "tagName": "span",
                    "props": {
                      "className": "text-xs text-slate-500 dark:text-slate-400",
                      "textContent": "${role} • ${email}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "tagName": "span",
            "props": {
              "className": "px-2.5 py-1 text-xs font-medium rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300",
              "textContent": "${status}",
              "dataset": {
                "status": "${status}"
              }
            }
          }
        ]
      }
    }
  ]
}
