  "author": "KeshavSoft",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/keshavsoft/json-to-dom/issues"
  },
  "homepage": "https://keshavsoft.github.io/json-to-dom/",
  "devDependencies": {
    "vite": "^8.2.1",
    "jsdom": "^29.1.1"
  },
  "dependencies": {}
}