{
  "name": "@keshavsoft/json-to-dom",
  "version": "42.1.5",
  "description": "Zero-dependency DOM orchestrator compiling JSON specifications into live browser DOM by orchestrating @keshavsoft/json-to-tag and spec-to-dom.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "docs/tags"
  ],
  "scripts": {
    "dev": "vite",
    "test": "node --test \"test/*.test.js\"",
    "build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/json-to-dom.git"
  },
  "keywords": [
    "json-to-dom",
    "dom-orchestrator",
    "json-to-tag",
    "spec-to-dom",
    "declarative-ui",
    "dom-builder",
    "zero-dependency"
  ],
  "author": "KeshavSoft",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/keshavsoft/json-to-dom/issues"
  },
  "homepage": "https://keshavsoft.github.io/json-to-dom/",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "spec-to-dom": "^1.2.2",
    "@keshavsoft/json-to-tag": "^1.12.2"
  }
}
