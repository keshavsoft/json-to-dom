{
  "name": "@keshavsoft/json-to-dom",
  "version": "1.41.3",
  "description": "Zero-dependency Custom HTML Web Components and Tailwind CSS tokens for high-performance forms and tables.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "json-to-dom": "bin/cli.js"
  },
  "files": [
