    "test": "node --test \"test/*.test.js\"",
    "build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/json-to-dom.git"
  },
  "keywords": [
    "web-components",
    "table-cell-content",
    "tailwind-tokens",
    "custom-elements"
